# BLOQUE 11B. COEFICIENTES GENERICOS an Y bn
# ==========================================================

n_generico = sp.symbols("n", integer=True, positive=True)

a_n_generico = 0
b_n_generico = 0

for expresion, a, b in tramos:
    variable = obtener_variable(expresion)

    if variable is None:
        variable = t

    argumento_generico = (
        n_generico * w0 * (variable - t_referencia)
    )

    a_n_generico += (2 / T) * sp.integrate(
        expresion * sp.cos(argumento_generico),
        (variable, a, b),
        conds='none'
    )

    b_n_generico += (2 / T) * sp.integrate(
        expresion * sp.sin(argumento_generico),
        (variable, a, b),
        conds='none'
    )

a_n_generico = sp.simplify(
    sp.trigsimp(
        sp.refine(a_n_generico, sp.Q.integer(n_generico))
    )
)

b_n_generico = sp.simplify(
    sp.trigsimp(
        sp.refine(b_n_generico, sp.Q.integer(n_generico))
    )
)

