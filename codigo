def leer_numero(texto):
    """
    Permite ingresar enteros, decimales, fracciones y valores
    simbólicos como pi.
    """
    try:
        return sp.Rational(texto)
    except Exception:
        return sp.sympify(texto)


def obtener_variable(expresion):
    """Obtiene la variable que realmente pertenece a la expresión."""
    simbolos = list(expresion.free_symbols)

    if len(simbolos) == 0:
        return None

    for simbolo in simbolos:
        if str(simbolo) == "t":
            return simbolo

    if len(simbolos) == 1:
        return simbolos[0]

    return simbolos[0]


def simplificar(expr):
    """Simplificación simbólica exacta."""
    return sp.factor(
        sp.cancel(
            sp.simplify(expr)
        )
    )


def son_iguales(valor_1, valor_2):
    """Comprueba igualdad simbólica entre dos valores."""
    return sp.simplify(valor_1 - valor_2) == 0


def reconstruir_tramos(tramos_base, tipo, centro, mitad, cuarto):
    """
    Reconstruye un periodo completo a partir del primer medio
    periodo (opciones 1 a 3) o del cuarto de referencia (4 y 5),
    según la simetría seleccionada.

    Los tramos se representan como:
        (expresion, limite_inferior, limite_superior)
    """
    tramos_completos = []

    if tipo == 1:
        for expresion, a, b in tramos_base:
            tramos_completos.append((expresion, a, b))
            expresion_reflejada = expresion.subs(t, 2 * centro - t)

            tramos_completos.append((
                expresion_reflejada,
                2 * centro - b,
                2 * centro - a
            ))

    elif tipo == 2:
        for expresion, a, b in tramos_base:
            tramos_completos.append((expresion, a, b))
            expresion_reflejada = -expresion.subs(t, 2 * centro - t)

            tramos_completos.append((
                expresion_reflejada,
                2 * centro - b,
                2 * centro - a
            ))

    elif tipo == 3:
        for expresion, a, b in tramos_base:
            tramos_completos.append((expresion, a, b))
            expresion_desplazada = -expresion.subs(t, t - mitad)
            tramos_completos.append((
                expresion_desplazada,
                a + mitad,
                b + mitad
            ))

    elif tipo == 4:
        for expresion, a, b in tramos_base:
            tramos_completos.append((expresion, a, b))
            expresion_segundo = -expresion.subs(t, 2 * centro + mitad - t)

            tramos_completos.append((
                expresion_segundo,
                2 * centro + mitad - b,
                2 * centro + mitad - a
            ))
            expresion_tercero = expresion.subs(t, 2 * centro - t)

            tramos_completos.append((
                expresion_tercero,
                2 * centro - b,
                2 * centro - a
            ))
            expresion_cuarto = -expresion.subs(t, t + mitad)
            tramos_completos.append((
                expresion_cuarto,
                a - mitad,
                b - mitad
            ))

    elif tipo == 5:
        for expresion, a, b in tramos_base:
            tramos_completos.append((expresion, a, b))
            expresion_segundo = expresion.subs(t, 2 * centro + mitad - t)

            tramos_completos.append((
                expresion_segundo,
                2 * centro + mitad - b,
                2 * centro + mitad - a
            ))
            expresion_tercero = -expresion.subs(t, 2 * centro - t)

            tramos_completos.append((
                expresion_tercero,
                2 * centro - b,
                2 * centro - a
            ))
            expresion_cuarto = -expresion.subs(t, t + mitad)
            tramos_completos.append((
                expresion_cuarto,
                a - mitad,
                b - mitad
            ))

    tramos_completos.sort(key=lambda tramo: float(tramo[1]))
    return tramos_completos


def forzar_simetria_completa(tramos_originales, tipo, inicio, final, centro=None, mitad=None):
    """
    Construye una señal con la simetría deseada tomando TODA la señal
    original ingresada en [inicio, final] como bloque generador, sin
    borrar ni promediar destructivamente ninguno de sus tramos:

    - Tipo 1 (Par): La señal original en [inicio, final] es la mitad derecha.
      Se refleja de forma par hacia [inicio - L, inicio] respecto a t = inicio.
      Nuevo periodo: T = 2*L, eje de simetría: t_eje = inicio.

    - Tipo 2 (Impar): La señal original en [inicio, final] es la mitad derecha.
      Se refleja e invierte hacia [inicio - L, inicio] respecto a t = inicio.
      Nuevo periodo: T = 2*L, eje de simetría: t_eje = inicio.

    - Tipo 3 (Media onda): La señal original en [inicio, final] es el primer
      medio periodo. El segundo medio periodo en [final, final + L] se obtiene
      desplazando L e invirtiendo el signo: -f(t - L).
      Nuevo periodo: T = 2*L, eje de referencia: t_eje = inicio.

    - Tipo 4 (Cuarto de onda Par): La señal original en [inicio, final] es el
      primer cuarto de periodo (T/4 = L -> T = 4*L).
      Cuarto 1 [inicio, inicio + L]: f(t) (Original, simétrica par respecto a inicio)
      Cuarto 2 [inicio + L, inicio + 2L]: -f(2*final - t) (Antisimétrica en T/4)
      Cuarto 3 [inicio + 2L, inicio + 3L]: -f(t - 2L) (Media onda del Cuarto 1)
      Cuarto 4 [inicio + 3L, inicio + 4L]: +f(4*final - 3*inicio - t) (Media onda del Cuarto 2)
      Así cumple simultáneamente f(inicio - x) = f(inicio + x) y f(t + T/2) = -f(t).

    - Tipo 5 (Cuarto de onda Impar): La señal original en [inicio, final] es el
      primer cuarto de periodo (T/4 = L -> T = 4*L).
      Cuarto 1 [inicio, inicio + L]: f(t) (Original)
      Cuarto 2 [inicio + L, inicio + 2L]: +f(2*final - t) (Simétrica par en T/4)
      Cuarto 3 [inicio + 2L, inicio + 3L]: -f(t - 2L) (Media onda del Cuarto 1)
      Cuarto 4 [inicio + 3L, inicio + 4L]: -f(4*final - 3*inicio - t) (Media onda del Cuarto 2)
      Así cumple simultáneamente f(inicio - x) = -f(inicio + x) y f(t + T/2) = -f(t).
    """
    L = simplificar(final - inicio)
    tramos_resultado = []
    tramos_detalle = []  # (expresion, a, b, etiqueta_bloque)

    if tipo == 1:
        # Simetría Par respecto a t = inicio -> Periodo [inicio - L, final]
        nuevo_t_min = simplificar(inicio - L)
        nuevo_t_max = simplificar(final)
        t_eje = simplificar(inicio)

        for expr, a, b in tramos_originales:
            # Tramo original (mitad derecha)
            tramos_detalle.append((sp.simplify(expr), simplificar(a), simplificar(b), "Original (Mitad derecha)"))
            # Tramo reflejado par respecto a 'inicio': t -> 2*inicio - t
            expr_ref = sp.simplify(expr.subs(t, 2 * inicio - t))
            a_ref = simplificar(2 * inicio - b)
            b_ref = simplificar(2 * inicio - a)
            tramos_detalle.append((expr_ref, a_ref, b_ref, "Reflejo Par (Mitad izquierda)"))

    elif tipo == 2:
        # Simetría Impar respecto a t = inicio -> Periodo [inicio - L, final]
        nuevo_t_min = simplificar(inicio - L)
        nuevo_t_max = simplificar(final)
        t_eje = simplificar(inicio)

        for expr, a, b in tramos_originales:
            # Tramo original (mitad derecha)
            tramos_detalle.append((sp.simplify(expr), simplificar(a), simplificar(b), "Original (Mitad derecha)"))
            # Tramo reflejado impar respecto a 'inicio': -f(2*inicio - t)
            expr_ref = sp.simplify(-expr.subs(t, 2 * inicio - t))
            a_ref = simplificar(2 * inicio - b)
            b_ref = simplificar(2 * inicio - a)
            tramos_detalle.append((expr_ref, a_ref, b_ref, "Reflejo Impar (Mitad izquierda)"))

    elif tipo == 3:
        # Simetría de Media Onda -> Periodo [inicio, inicio + 2*L]
        nuevo_t_min = simplificar(inicio)
        nuevo_t_max = simplificar(inicio + 2 * L)
        t_eje = simplificar(inicio)

        for expr, a, b in tramos_originales:
            # Primer medio periodo (original)
            tramos_detalle.append((sp.simplify(expr), simplificar(a), simplificar(b), "Original (1er Medio Periodo)"))
            # Segundo medio periodo: desplazado L e invertido -f(t - L)
            expr_mw = sp.simplify(-expr.subs(t, t - L))
            a_mw = simplificar(a + L)
            b_mw = simplificar(b + L)
            tramos_detalle.append((expr_mw, a_mw, b_mw, "Media Onda -f(t - T/2) (2do Medio Periodo)"))

    elif tipo == 4:
        # Simetría de Cuarto de Onda Par -> Periodo [inicio, inicio + 4*L]
        # Eje par en t = inicio (solo cosenos impares)
        nuevo_t_min = simplificar(inicio)
        nuevo_t_max = simplificar(inicio + 4 * L)
        t_eje = simplificar(inicio)

        for expr, a, b in tramos_originales:
            # 1er Cuarto [inicio, inicio + L]: Original
            tramos_detalle.append((sp.simplify(expr), simplificar(a), simplificar(b), "1er Cuarto (Original)"))

            # 2do Cuarto [inicio + L, inicio + 2L]: Reflexión impar respecto a t = final (T/4)
            expr_q2 = sp.simplify(-expr.subs(t, 2 * final - t))
            a_q2 = simplificar(2 * final - b)
            b_q2 = simplificar(2 * final - a)
            tramos_detalle.append((expr_q2, a_q2, b_q2, "2do Cuarto (Antisimétrico en T/4)"))

            # 3er Cuarto [inicio + 2L, inicio + 3L]: Media onda del 1er cuarto -> -f(t - 2L)
            expr_q3 = sp.simplify(-expr.subs(t, t - 2 * L))
            a_q3 = simplificar(a + 2 * L)
            b_q3 = simplificar(b + 2 * L)
            tramos_detalle.append((expr_q3, a_q3, b_q3, "3er Cuarto (Media onda Q1)"))

            # 4to Cuarto [inicio + 3L, inicio + 4L]: Media onda del 2do cuarto -> +f(2*final - (t - 2L))
            expr_q4 = sp.simplify(expr.subs(t, 2 * final + 2 * L - t))
            a_q4 = simplificar(2 * final + 2 * L - b)
            b_q4 = simplificar(2 * final + 2 * L - a)
            tramos_detalle.append((expr_q4, a_q4, b_q4, "4to Cuarto (Reflejo Par en T)"))

    elif tipo == 5:
        # Simetría de Cuarto de Onda Impar -> Periodo [inicio, inicio + 4*L]
        # Eje impar en t = inicio (solo senos impares)
        nuevo_t_min = simplificar(inicio)
        nuevo_t_max = simplificar(inicio + 4 * L)
        t_eje = simplificar(inicio)

        for expr, a, b in tramos_originales:
            # 1er Cuarto [inicio, inicio + L]: Original
            tramos_detalle.append((sp.simplify(expr), simplificar(a), simplificar(b), "1er Cuarto (Original)"))

            # 2do Cuarto [inicio + L, inicio + 2L]: Reflexión par respecto a t = final (T/4)
            expr_q2 = sp.simplify(expr.subs(t, 2 * final - t))
            a_q2 = simplificar(2 * final - b)
            b_q2 = simplificar(2 * final - a)
            tramos_detalle.append((expr_q2, a_q2, b_q2, "2do Cuarto (Simétrico en T/4)"))

            # 3er Cuarto [inicio + 2L, inicio + 3L]: Media onda del 1er cuarto -> -f(t - 2L)
            expr_q3 = sp.simplify(-expr.subs(t, t - 2 * L))
            a_q3 = simplificar(a + 2 * L)
            b_q3 = simplificar(b + 2 * L)
            tramos_detalle.append((expr_q3, a_q3, b_q3, "3er Cuarto (Media onda Q1)"))

            # 4to Cuarto [inicio + 3L, inicio + 4L]: Media onda del 2do cuarto -> -f(2*final + 2L - t)
            expr_q4 = sp.simplify(-expr.subs(t, 2 * final + 2 * L - t))
            a_q4 = simplificar(2 * final + 2 * L - b)
            b_q4 = simplificar(2 * final + 2 * L - a)
            tramos_detalle.append((expr_q4, a_q4, b_q4, "4to Cuarto (Reflejo Impar en T)"))
    else:
        raise ValueError("Tipo de simetria no valido para forzar la senal.")

    tramos_detalle.sort(key=lambda item: float(item[1]))
    tramos_resultado = [(expr, a, b) for expr, a, b, _ in tramos_detalle]

    return tramos_resultado, tramos_detalle, nuevo_t_min, nuevo_t_max, t_eje


def validar_tramos_base(tramos_base, inicio, final):
    """Comprueba que los tramos cubran sin huecos el intervalo solicitado."""
    if len(tramos_base) == 0:
        return False, "No se ingreso ningun tramo."

    tramos_ordenados = sorted(
        tramos_base,
        key=lambda tramo: float(tramo[1])
    )

    if not son_iguales(tramos_ordenados[0][1], inicio):
        return False, f"El primer tramo debe comenzar en {inicio}."

    for i in range(len(tramos_ordenados) - 1):
        limite_actual = tramos_ordenados[i][2]
        limite_siguiente = tramos_ordenados[i + 1][1]

        if not son_iguales(limite_actual, limite_siguiente):
            return False, (
                "Hay un espacio o una superposicion entre dos tramos. "
                f"El limite esperado es {limite_actual}, "
                f"pero el siguiente comienza en {limite_siguiente}."
            )

    if not son_iguales(tramos_ordenados[-1][2], final):
        return False, f"El ultimo tramo debe terminar en {final}."

    for expresion, a, b in tramos_ordenados:
        if float(b) <= float(a):
            return False, "Cada tramo debe tener limite inferior menor que limite superior."

    return True, "Tramos correctos."


def extraer_tramos_intervalo(tramos_completos, inicio, final):
    """Extrae de una senal completa los tramos que pertenecen a un intervalo."""
    resultado = []

    for expresion, a, b in tramos_completos:
        nuevo_a = inicio if float(a) < float(inicio) else a
        nuevo_b = final if float(b) > float(final) else b

        if float(nuevo_b) > float(nuevo_a):
            resultado.append((expresion, nuevo_a, nuevo_b))

    resultado.sort(key=lambda tramo: float(tramo[1]))
    return resultado


def evaluar_funcion(funcion, puntos):
    """Evalua una funcion y garantiza un vector del mismo largo que puntos."""
    valores = np.asarray(funcion(puntos))

    if valores.ndim == 0:
        valores = np.full_like(
            puntos,
            valores,
            dtype=np.result_type(valores, float)
        )

    return np.real(valores)


