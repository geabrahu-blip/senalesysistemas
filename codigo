a0 = 0

for expresion, a, b in tramos:
    variable = obtener_variable(expresion)

    if variable is None:
        a0 += (2 / T) * expresion * (b - a)
    else:
        a0 += (2 / T) * sp.integrate(
            expresion,
            (variable, a, b),
            conds='none'
        )

a0 = sp.simplify(a0)


# ----------------------------------------------------------
# an Y bn
# ----------------------------------------------------------

an = []
bn = []

for n in range(1, N1 + 1):
    a_n = 0
    b_n = 0

    for expresion, a, b in tramos:
        variable = obtener_variable(expresion)

        if variable is None:
            variable = t

        argumento = n * w0 * (variable - t_referencia)

        a_n += (2 / T) * sp.integrate(
            expresion * sp.cos(argumento),
            (variable, a, b),
            conds='none'
        )

        b_n += (2 / T) * sp.integrate(
            expresion * sp.sin(argumento),
            (variable, a, b),
            conds='none'
        )

    an.append(sp.simplify(a_n))
    bn.append(sp.simplify(b_n))


# ==========================================================
# BLOQUE 9. CONSTRUIR SERIE DE FOURIER
# ==========================================================

serie_fourier = sp.simplify(a0 / 2)

for n in range(1, N1 + 1):
    argumento = n * w0 * (t - t_referencia)

    serie_fourier += (
        sp.simplify(an[n - 1]) * sp.cos(argumento)
        +
        sp.simplify(bn[n - 1]) * sp.sin(argumento)
    )


