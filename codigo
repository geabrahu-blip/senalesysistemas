def seleccionar_ruta_imagen():
    """Abre el selector de archivos de Windows; si se cancela, pide la ruta por consola."""
    ruta = ""
    try:
        import tkinter as tk
        from tkinter import filedialog
        raiz = tk.Tk()
        raiz.withdraw()
        raiz.attributes("-topmost", True)
        ruta = filedialog.askopenfilename(
            title="Seleccione la imagen de la señal",
            filetypes=[
                ("Imágenes", "*.png *.jpg *.jpeg *.bmp *.webp *.tif *.tiff"),
                ("Todos los archivos", "*.*")
            ]
        )
        raiz.destroy()
    except Exception:
        ruta = ""

    if not ruta:
        ruta = input("Ingrese o arrastre aqui la ruta de la imagen: ").strip().strip('"').strip("'")

    return ruta


def cargar_imagen_segura(ruta):
    """
    Carga imagenes incluso si la ruta tiene tildes, espacios o ñ en Windows,
    y maneja PNGs con fondo transparente (canal alfa) y modo oscuro.
    """
    ruta_limpia = ruta.strip().strip('"').strip("'")
    if not os.path.isfile(ruta_limpia):
        raise FileNotFoundError(f"No se encontro el archivo: {ruta_limpia}")

    datos = np.fromfile(ruta_limpia, dtype=np.uint8)
    img = cv2.imdecode(datos, cv2.IMREAD_UNCHANGED)
    if img is None:
        raise ValueError("No se pudo decodificar la imagen. Verifica el formato.")

    if img.ndim == 3 and img.shape[2] == 4:
        bgr = img[:, :, :3].astype(np.float32)
        alfa = img[:, :, 3:4].astype(np.float32) / 255.0
        fondo = np.full_like(bgr, 255.0)
        img = (bgr * alfa + fondo * (1.0 - alfa)).astype(np.uint8)
    elif img.ndim == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)

    gris_tmp = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    if np.median(gris_tmp) < 120:
        img = 255 - img

    h, w = img.shape[:2]
    max_dim = max(h, w)
    if max_dim > 1400:
        escala = 1400.0 / max_dim
        img = cv2.resize(img, (int(w * escala), int(h * escala)), interpolation=cv2.INTER_AREA)

    return img


def recortar_marco_grafica(img):
    """
    Si la imagen tiene un recuadro rectangular externo (Matplotlib, MATLAB, Excel),
    recorta su interior para eliminar numeros de ejes y titulos externos.
    """
    h, w = img.shape[:2]
    area_img = h * w
    gris = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    chroma = np.max(img, axis=2).astype(np.int16) - np.min(img, axis=2).astype(np.int16)

    neutro_oscuro = ((chroma < 45) & (gris < 190)).astype(np.uint8) * 255
    bordes = cv2.dilate(neutro_oscuro, np.ones((3, 3), np.uint8), iterations=1)
    res_cnt = cv2.findContours(bordes, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
    contornos = res_cnt[0] if len(res_cnt) == 2 else res_cnt[1]

    mejor_caja = None
    mejor_area = 0

    for cnt in contornos:
        x, y, cw, ch = cv2.boundingRect(cnt)
        area_caja = cw * ch
        if 0.20 * area_img < area_caja < 0.96 * area_img:
            if cw > 0.35 * w and ch > 0.25 * h:
                borde_sup = np.mean(neutro_oscuro[y:min(h, y + 4), x:x + cw] > 0)
                borde_inf = np.mean(neutro_oscuro[max(0, y + ch - 4):y + ch, x:x + cw] > 0)
                borde_izq = np.mean(neutro_oscuro[y:y + ch, x:min(w, x + 4)] > 0)
                borde_der = np.mean(neutro_oscuro[y:y + ch, max(0, x + cw - 4):x + cw] > 0)

                if borde_sup > 0.70 and borde_inf > 0.70 and borde_izq > 0.70 and borde_der > 0.70:
                    if area_caja > mejor_area:
                        mejor_area = area_caja
                        mejor_caja = (x, y, cw, ch)

    if mejor_caja is not None:
        x, y, cw, ch = mejor_caja
        margen = max(3, int(0.008 * min(cw, ch)))
        roi = img[y + margen:y + ch - margen, x + margen:x + cw - margen]
        if roi.size > 0:
            return roi, True

    return img.copy(), False


def _agrupar_indices(indices, pesos):
    """Agrupa filas o columnas adyacentes de una linea gruesa y devuelve su centro."""
    indices_arr = np.asarray(indices, dtype=np.int64)
    if indices_arr.size == 0:
        return []
    grupos = []
    inicio = 0
    for i in range(1, len(indices_arr)):
        if int(indices_arr[i]) - int(indices_arr[i - 1]) > 5:
            seg = indices_arr[inicio:i]
            w_seg = pesos[seg]
            if float(np.sum(w_seg)) > 0.0:
                centro_g = int(np.round(np.average(seg, weights=w_seg)))
            else:
                centro_g = int(np.round(np.mean(seg)))
            grupos.append((centro_g, float(np.max(w_seg))))
            inicio = i
    seg = indices_arr[inicio:]
    w_seg = pesos[seg]
    if float(np.sum(w_seg)) > 0.0:
        centro_g = int(np.round(np.average(seg, weights=w_seg)))
    else:
        centro_g = int(np.round(np.mean(seg)))
    grupos.append((centro_g, float(np.max(w_seg))))
    return grupos


def _mascara_tinta_neutra(roi, factor_oscuro=0.72, max_chroma=52):
    """
    Detecta lineas negras/gris oscuro incluso sobre fondos amarillentos o crema,
    usando croma (max-min de BGR) en lugar de saturacion HSV.
    """
    gris = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    bg_gris = float(np.percentile(gris, 85))
    chroma = np.max(roi, axis=2).astype(np.int16) - np.min(roi, axis=2).astype(np.int16)
    umbral_g = min(155.0, bg_gris * factor_oscuro)
    return ((chroma < max_chroma) & (gris < umbral_g)).astype(np.uint8) * 255


def enderezar_y_detectar_ejes(roi):
    """
    1) Usa Transformada de Hough sobre las lineas oscuras neutras para detectar
       si la imagen/foto tiene una ligera inclinacion (hasta ±10°) y la endereza.
    2) Localiza con precision las coordenadas en pixeles (x0, y0) de los ejes
       vertical (t = 0) y horizontal (y = 0).
    """
    h, w = roi.shape[:2]
    masc_negro = _mascara_tinta_neutra(roi, factor_oscuro=0.72, max_chroma=52)

    lineas = cv2.HoughLinesP(
        masc_negro,
        rho=1,
        theta=np.pi / 360.0,
        threshold=max(40, int(0.18 * min(h, w))),
        minLineLength=max(40, int(0.22 * w)),
        maxLineGap=max(12, int(0.04 * w))
    )

    angulo_corr = 0.0
    if lineas is not None:
        lineas_arr = np.asarray(lineas)
        if lineas_arr.size >= 4 and (lineas_arr.size % 4 == 0):
            lineas_2d = lineas_arr.reshape(-1, 4)
            angulos_h = []
            pesos_h = []
            for fila in lineas_2d:
                x1 = int(fila[0])
                y1 = int(fila[1])
                x2 = int(fila[2])
                y2 = int(fila[3])
                if x2 < x1:
                    x1, y1, x2, y2 = x2, y2, x1, y1
                dx = float(x2 - x1)
                dy = float(y2 - y1)
                largo = math.hypot(dx, dy)
                ang = math.degrees(math.atan2(dy, dx))
                if abs(ang) < 10.0 and largo > 0.22 * w:
                    angulos_h.append(ang)
                    pesos_h.append(largo)

            if angulos_h:
                orden = np.argsort(angulos_h)
                ang_ord = np.array(angulos_h)[orden]
                pes_ord = np.array(pesos_h)[orden]
                acum = np.cumsum(pes_ord)
                idx_med = int(np.searchsorted(acum, 0.5 * acum[-1]))
                angulo_corr = float(ang_ord[min(idx_med, len(ang_ord) - 1)])

    if 0.25 < abs(angulo_corr) < 10.0:
        bg_bgr = np.median(roi.reshape(-1, 3), axis=0)
        M_rot = cv2.getRotationMatrix2D((w / 2.0, h / 2.0), angulo_corr, 1.0)
        roi = cv2.warpAffine(
            roi,
            M_rot,
            (w, h),
            flags=cv2.INTER_LINEAR,
            borderMode=cv2.BORDER_CONSTANT,
            borderValue=(int(bg_bgr[0]), int(bg_bgr[1]), int(bg_bgr[2]))
        )

    gris = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    x0_detectado = None
    y0_detectado = None

    for factor_osc in (0.62, 0.78):
        masc_eje = (_mascara_tinta_neutra(roi, factor_oscuro=factor_osc, max_chroma=52) > 0).astype(np.uint8)

        ker_h = cv2.getStructuringElement(cv2.MORPH_RECT, (max(11, w // 35), 1))
        ker_v = cv2.getStructuringElement(cv2.MORPH_RECT, (1, max(11, h // 35)))
        masc_h = cv2.morphologyEx(masc_eje, cv2.MORPH_CLOSE, ker_h)
        masc_v = cv2.morphologyEx(masc_eje, cv2.MORPH_CLOSE, ker_v)

        if y0_detectado is None:
            cobertura_h = np.mean(masc_h > 0, axis=1)
            intensidad_h = np.mean((255.0 - gris) * masc_eje, axis=1)
            margen_y = max(3, int(0.03 * h))
            cand_y = np.where(cobertura_h[margen_y:h - margen_y] > 0.35)[0] + margen_y
            grupos_y = _agrupar_indices(cand_y, cobertura_h * (intensidad_h + 1.0))

            if 1 <= len(grupos_y) <= 3:
                grupos_y.sort(key=lambda g: g[1], reverse=True)
                y0_detectado = grupos_y[0][0]
            elif len(grupos_y) > 3:
                grupos_y.sort(key=lambda g: g[1], reverse=True)
                if grupos_y[0][1] > 1.35 * grupos_y[1][1]:
                    y0_detectado = grupos_y[0][0]

        if x0_detectado is None:
            cobertura_v = np.mean(masc_v > 0, axis=0)
            intensidad_v = np.mean((255.0 - gris) * masc_eje, axis=0)
            margen_x = max(2, int(0.02 * w))
            cand_x = np.where(cobertura_v[margen_x:w - margen_x] > 0.30)[0] + margen_x
            grupos_x = _agrupar_indices(cand_x, cobertura_v * (intensidad_v + 1.0))

            if 1 <= len(grupos_x) <= 3:
                grupos_x.sort(key=lambda g: g[1], reverse=True)
                x0_detectado = grupos_x[0][0]
            elif len(grupos_x) > 3:
                grupos_x.sort(key=lambda g: g[1], reverse=True)
                if grupos_x[0][1] > 1.35 * grupos_x[1][1]:
                    x0_detectado = grupos_x[0][0]

        if x0_detectado is not None and y0_detectado is not None:
            break

    return roi, x0_detectado, y0_detectado, angulo_corr


def eliminar_cajas_leyenda(roi, masc_curva):
    """Descarta posibles recuadros de leyenda en las esquinas de la grafica."""
    h, w = roi.shape[:2]
    area_roi = h * w
    gris = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    chroma = np.max(roi, axis=2).astype(np.int16) - np.min(roi, axis=2).astype(np.int16)

    borde_leyenda = ((chroma < 45) & (gris < 215)).astype(np.uint8) * 255
    res_cnt = cv2.findContours(borde_leyenda, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    contornos = res_cnt[0] if len(res_cnt) == 2 else res_cnt[1]

    masc_limpia = masc_curva.copy()
    for cnt in contornos:
        x, y, cw, ch = cv2.boundingRect(cnt)
        area = cw * ch
        if 0.008 * area_roi < area < 0.18 * area_roi:
            perimetro = cv2.arcLength(cnt, True)
            aprox = cv2.approxPolyDP(cnt, 0.04 * perimetro, True)
            if len(aprox) == 4 and cw > 30 and ch > 18:
                en_borde = (x < 0.25 * w or x + cw > 0.75 * w) and (y < 0.30 * h or y + ch > 0.70 * h)
                if en_borde:
                    masc_limpia[max(0, y - 2):min(h, y + ch + 2), max(0, x - 2):min(w, x + cw + 2)] = 0

    return masc_limpia


def _filtrar_texto_y_artefactos_componentes(masc, w, h):
    """
    Elimina etiquetas del mismo color que la curva (ej. 'f(t)', 't', numeros),
    marcas pequeñas y rayitas verticales punteadas en discontinuidades,
    aprovechando que una funcion f(t) es univaluada en cada columna x.
    """
    masc_u8 = np.ascontiguousarray((masc > 0).astype(np.uint8) * 255)
    num_et, etiq, stats, _ = cv2.connectedComponentsWithStats(masc_u8, connectivity=8)
    if num_et <= 1:
        return masc_u8

    comps = []
    for i in range(1, num_et):
        x = int(stats[i, cv2.CC_STAT_LEFT])
        y = int(stats[i, cv2.CC_STAT_TOP])
        cw = int(stats[i, cv2.CC_STAT_WIDTH])
        ch = int(stats[i, cv2.CC_STAT_HEIGHT])
        area = int(stats[i, cv2.CC_STAT_AREA])
        if area < 20:
            continue
        comps.append((i, x, y, cw, ch, area))

    if not comps:
        return masc_u8

    comps.sort(key=lambda c: c[3], reverse=True)

    col_cubierta = np.zeros(w, dtype=bool)
    max_cw = comps[0][3]
    masc_out = np.zeros_like(masc_u8)

    for comp in comps:
        i, x, y, cw, ch, area = comp
        es_trazo_vertical = (cw < max(14, int(0.024 * w))) and (ch > 1.7 * cw)
        if es_trazo_vertical:
            continue

        if cw < max(24, int(0.08 * w)) and cw < 0.70 * max_cw:
            solapamiento = float(np.mean(col_cubierta[x:x + cw]))
            if solapamiento > 0.35:
                continue

        if cw < max(10, int(0.018 * w)) and ch < max(10, int(0.025 * h)) and area < 55:
            continue

        masc_out[etiq == i] = 255
        if cw >= max(18, int(0.045 * w)):
            col_cubierta[x:x + cw] = True

    if np.sum(masc_out > 0) < 40:
        return masc_u8

    return masc_out


def extraer_mascara_curva(roi, x0, y0):
    """
    Aisla la curva principal descartando ejes, cuadriculas, fondos crema,
    destellos/marcas de otro color y etiquetas del mismo color (como 'f(t)').
    """
    h, w = roi.shape[:2]
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    gris = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)

    bg_bgr = np.median(roi.reshape(-1, 3), axis=0).astype(np.float32)
    bg_chroma = float(np.max(bg_bgr) - np.min(bg_bgr))
    chroma = np.max(roi, axis=2).astype(np.float32) - np.min(roi, axis=2).astype(np.float32)
    dist_bg = np.linalg.norm(roi.astype(np.float32) - bg_bgr, axis=2)

    # --- ESTRATEGIA A: CURVA DE COLOR ---
    masc_col_raw = (
        (chroma > max(40.0, bg_chroma + 22.0))
        & (hsv[:, :, 1] > 55)
        & (hsv[:, :, 2] < 245)
        & (dist_bg > 45.0)
    )
    masc_col_u8 = eliminar_cajas_leyenda(roi, masc_col_raw.astype(np.uint8) * 255)
    masc_col_raw = masc_col_u8 > 0

    cols_color = np.where(np.any(masc_col_raw, axis=0))[0]
    if len(cols_color) > 0.22 * w:
        h_canal = hsv[:, :, 0].astype(np.int16)
        hist_bins = []
        for centro_h in range(5, 180, 10):
            dh = np.abs(h_canal - centro_h)
            dh = np.minimum(dh, 180 - dh)
            m_bin = masc_col_raw & (dh <= 16)
            cols_bin = np.where(np.any(m_bin, axis=0))[0]
            ancho_cov = len(cols_bin) / float(w)
            hist_bins.append((centro_h, ancho_cov, int(np.sum(m_bin))))

        hist_bins.sort(key=lambda b: (b[1], b[2]), reverse=True)
        hues_validos = [hist_bins[0][0]]
        for item_bin in hist_bins[1:]:
            centro_h = item_bin[0]
            ancho_cov = item_bin[1]
            if ancho_cov >= 0.14:
                if all(min(abs(centro_h - hv), 180 - abs(centro_h - hv)) >= 25 for hv in hues_validos):
                    hues_validos.append(centro_h)

        masc_hue = np.zeros((h, w), dtype=bool)
        for hv in hues_validos:
            dh = np.abs(h_canal - hv)
            dh = np.minimum(dh, 180 - dh)
            masc_hue |= (masc_col_raw & (dh <= 18))

        masc_filtrada = _filtrar_texto_y_artefactos_componentes(masc_hue.astype(np.uint8) * 255, w, h)
        if np.sum(masc_filtrada > 0) > 40:
            return masc_filtrada, "color"

    # --- ESTRATEGIA B: CURVA EN BLANCO Y NEGRO ---
    tam_k = max(15, (min(h, w) // 18) | 1)
    fondo = cv2.morphologyEx(gris, cv2.MORPH_CLOSE, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (tam_k, tam_k)))
    dif = cv2.subtract(fondo, gris)

    p99 = np.percentile(dif, 99.5)
    umbral_tinta = max(35, int(0.35 * p99))
    masc_bn = (dif > umbral_tinta).astype(np.uint8) * 255
    masc_bn = eliminar_cajas_leyenda(roi, masc_bn)

    masc_sin_ejes = masc_bn.copy()
    banda = max(3, int(0.009 * min(h, w)))
    if y0 is not None:
        masc_sin_ejes[max(0, y0 - banda):min(h, y0 + banda + 1), :] = 0
    if x0 is not None:
        masc_sin_ejes[:, max(0, x0 - banda):min(w, x0 + banda + 1)] = 0

    masc_limpia = _filtrar_texto_y_artefactos_componentes(masc_sin_ejes, w, h)
    return masc_limpia, "monocromo"


def _mediana_movil_1d(arr, k=5):
    """Suavizado por mediana 1D compatible con cualquier version de NumPy."""
    arr_f = np.asarray(arr, dtype=np.float64)
    n_pts = len(arr_f)
    if n_pts < k:
        return arr_f.copy()
    pad = k // 2
    ext = np.pad(arr_f, pad, mode="edge")
    pilas = np.vstack([ext[i:i + n_pts] for i in range(k)])
    return np.median(pilas, axis=0)


def extraer_senal_1d_imagen(masc_curva, x0, y0, modo_extraccion):
    """
    Convierte la mascara 2D de la curva en una senal 1D y(x) limpia y uniforme.
    """
    if masc_curva.ndim == 3:
        masc_curva = masc_curva[:, :, 0]
    h, w = masc_curva.shape[:2]

    ys_globales, xs_globales = np.where(masc_curva > 0)
    if len(xs_globales) < 20:
        raise ValueError("No se pudo detectar una senal clara en la imagen.")

    y_min_px = float(np.percentile(ys_globales, 1))
    y_max_px = float(np.percentile(ys_globales, 99))
    alto_senal = max(10.0, y_max_px - y_min_px)

    eje_y_estimado = False
    if y0 is None:
        y0 = 0.5 * (y_min_px + y_max_px)
        eje_y_estimado = True

    trazo = np.full(w, np.nan, dtype=np.float64)
    for col in range(w):
        ys = np.where(masc_curva[:, col] > 0)[0]
        if len(ys) == 0:
            continue

        if (ys[-1] - ys[0]) > 0.30 * alto_senal:
            densidad_vert = len(ys) / float(ys[-1] - ys[0] + 1)
            if densidad_vert > 0.35:
                continue

        trazo[col] = float(y0) - float(np.median(ys))

    validos = np.where(~np.isnan(trazo))[0]
    if len(validos) < 20:
        raise ValueError("La senal extraida tiene muy pocos puntos validos.")

    x_ini = int(validos[0])
    x_fin = int(validos[-1])
    if x_fin - x_ini < 20:
        raise ValueError("El ancho de la senal detectada es insuficiente.")

    sub_trazo = trazo[x_ini:x_fin + 1].copy()
    n_sub = len(sub_trazo)

    es_nan = np.isnan(sub_trazo)
    if np.any(es_nan):
        idx_val = np.where(~es_nan)[0]
        sub_interp = np.interp(np.arange(n_sub), idx_val, sub_trazo[idx_val])

        if modo_extraccion == "monocromo":
            cambios = np.diff(np.concatenate(([0], es_nan.astype(np.int64), [0])))
            inicios_nan = np.where(cambios == 1)[0]
            fines_nan = np.where(cambios == -1)[0]
            for a_idx, b_idx in zip(inicios_nan, fines_nan):
                if (int(b_idx) - int(a_idx)) > max(14, int(0.06 * n_sub)):
                    sub_interp[int(a_idx):int(b_idx)] = 0.0

        sub_trazo = sub_interp

    M = 600
    x_viejo = np.linspace(0, n_sub - 1, n_sub)
    x_nuevo = np.linspace(0, n_sub - 1, M)
    y_norm = np.interp(x_nuevo, x_viejo, sub_trazo)
    y_norm = _mediana_movil_1d(y_norm, k=5)

    eje_x_estimado = False
    if x0 is not None:
        idx_x0 = int(np.round((x0 - x_ini) * (M - 1) / float(x_fin - x_ini)))
        if idx_x0 < -int(0.10 * M) or idx_x0 > int(1.10 * M):
            idx_x0 = M // 2
            eje_x_estimado = True
        else:
            idx_x0 = int(np.clip(idx_x0, 0, M - 1))
    else:
        idx_x0 = M // 2
        eje_x_estimado = True

    escala_y = float(np.percentile(np.abs(y_norm), 99))
    if escala_y < 1e-6:
        escala_y = 1.0
    y_norm = y_norm / escala_y

    return y_norm, idx_x0, (x_ini, x_fin, y0, x0, eje_x_estimado, eje_y_estimado)


def error_suave_1d(a_vec, b_vec, tol_px=5, usar_ac=False):
    """
    Calcula el error normalizado entre dos señales 1D con tolerancia horizontal
    minima para evitar falsos errores por rasterizacion en saltos verticales.
    """
    n_len = len(a_vec)
    if n_len < 10:
        return 1.0

    def dist_dir(u_v, v_v):
        min_d = np.abs(u_v - v_v)
        for shift in range(1, tol_px + 1):
            d_der = np.abs(u_v[:-shift] - v_v[shift:])
            min_d[:-shift] = np.minimum(min_d[:-shift], d_der)
            d_izq = np.abs(u_v[shift:] - v_v[:-shift])
            min_d[shift:] = np.minimum(min_d[shift:], d_izq)
        return min_d

    err_punto = 0.5 * (dist_dir(a_vec, b_vec) + dist_dir(b_vec, a_vec))
    mae = float(np.mean(err_punto))

    if usar_ac:
        ac_a = float(np.std(a_vec))
        ac_b = float(np.std(b_vec))
        escala_ac = 0.5 * (ac_a + ac_b)
        if escala_ac < 0.04:
            denom = max(float(np.mean(np.abs(a_vec) + np.abs(b_vec)) * 0.5), 1e-6)
            return mae / denom
        return mae / (escala_ac * 1.4142 + 1e-6)
    else:
        rms = float(np.sqrt(0.5 * (np.mean(a_vec ** 2) + np.mean(b_vec ** 2))))
        if rms < 1e-6:
            return 1.0
        return mae / rms


def detectar_media_onda_imagen(y, umbral=0.20):
    """
    Busca si existe un semiperiodo h = T/2 tal que f(t + h) = -f(t)
    en toda la porcion visible de la senal (soporta de 1 hasta ~8 periodos).
    """
    M = len(y)
    h_min = max(18, int(0.06 * M))
    h_max = int(0.54 * M)

    errores = []
    for h in range(h_min, h_max + 1, 2):
        err = error_suave_1d(y[:-h], -y[h:], tol_px=5, usar_ac=False)
        errores.append((h, err))

    candidatos = []
    for i in range(len(errores)):
        h_act, e_act = errores[i]
        if e_act < umbral:
            e_izq = errores[i - 1][1] if i > 0 else 999.0
            e_der = errores[i + 1][1] if i < len(errores) - 1 else 999.0
            if e_act <= e_izq and e_act <= e_der:
                candidatos.append((h_act, e_act))

    if candidatos:
        h_base = candidatos[0][0]
        mejor_h = h_base
        mejor_err = candidatos[0][1]
        for h in range(max(h_min, h_base - 4), min(h_max, h_base + 4) + 1):
            err = error_suave_1d(y[:-h], -y[h:], tol_px=5, usar_ac=False)
            if err < mejor_err:
                mejor_err = err
                mejor_h = h

        fin_p = min(M, 2 * mejor_h)
        rms_p = float(np.sqrt(np.mean(y[:fin_p] ** 2))) + 1e-6
        dc_rel = abs(float(np.mean(y[:fin_p]))) / rms_p

        if mejor_err < umbral and dc_rel < 0.22:
            return True, mejor_err, mejor_h

    h_min_global, err_min_global = min(errores, key=lambda x: x[1])
    return False, err_min_global, h_min_global


def detectar_periodo_positivo_imagen(y):
    """Estima el periodo T en muestras buscando la primera repeticion f(t + T) = f(t)."""
    M = len(y)
    t_min_p = int(0.12 * M)
    t_max_p = int(0.68 * M)

    errores = []
    for p in range(t_min_p, t_max_p + 1, 3):
        err = error_suave_1d(y[:-p], y[p:], tol_px=5, usar_ac=True)
        errores.append((p, err))

    for i in range(1, len(errores) - 1):
        p_act, e_act = errores[i]
        if e_act < 0.18 and e_act <= errores[i - 1][1] and e_act <= errores[i + 1][1]:
            return p_act

    return None


def clasificar_simetria_imagen(y, idx_x0, umbral=0.20):
    """
    Evalua simultaneamente simetria par, impar, media onda, cuarto de onda par,
    cuarto de onda impar o ninguna simetria (asimetrica).
    """
    M = len(y)

    if float(np.max(np.abs(y))) < 1e-4:
        return "SENAL NULA (f(t) = 0)", {
            "par": 0.0, "impar": 0.0, "media_onda": 0.0,
            "es_par": False, "es_impar": False, "es_media_onda": False
        }, None

    es_media_onda, err_mw, h_mw = detectar_media_onda_imagen(y, umbral=umbral)

    # Caso A: El eje t = 0 esta en el interior de la grafica
    if int(0.15 * M) <= idx_x0 <= int(0.85 * M):
        mejor_err_par = 999.0
        mejor_err_impar = 999.0

        for delta in range(-7, 8):
            c = idx_x0 + delta
            radio = min(c, M - 1 - c)
            if radio < int(0.12 * M):
                continue

            der = y[c:c + radio]
            izq = y[c - radio + 1:c + 1][::-1]

            e_par = error_suave_1d(izq, der, tol_px=5, usar_ac=True)
            e_imp = error_suave_1d(izq, -der, tol_px=5, usar_ac=False)

            if e_par < mejor_err_par:
                mejor_err_par = e_par
            if e_imp < mejor_err_impar:
                mejor_err_impar = e_imp

        err_par = mejor_err_par
        err_impar = mejor_err_impar
        T_estimado = (2 * h_mw) if es_media_onda else detectar_periodo_positivo_imagen(y)

    # Caso B: El eje t = 0 esta en el borde izquierdo (ej. [0, T]) o derecho
    else:
        if es_media_onda:
            T_estimado = min(M, 2 * h_mw)
        else:
            T_pos = detectar_periodo_positivo_imagen(y)
            T_estimado = T_pos if T_pos is not None else M

        if idx_x0 < int(0.15 * M):
            seg = y[idx_x0:min(M, idx_x0 + T_estimado)]
        else:
            seg = y[max(0, idx_x0 - T_estimado):idx_x0 + 1]

        err_par = error_suave_1d(seg, seg[::-1], tol_px=5, usar_ac=True)
        err_impar = error_suave_1d(seg, -seg[::-1], tol_px=5, usar_ac=False)

    es_par = err_par < umbral
    es_impar = err_impar < umbral

    if es_par and es_impar:
        if err_par <= err_impar:
            es_impar = False
        else:
            es_par = False

    if es_par and es_media_onda:
        clasificacion = "SIMETRIA DE CUARTO DE ONDA PAR"
    elif es_impar and es_media_onda:
        clasificacion = "SIMETRIA DE CUARTO DE ONDA IMPAR"
    elif es_par:
        clasificacion = "SIMETRIA PAR"
    elif es_impar:
        clasificacion = "SIMETRIA IMPAR"
    elif es_media_onda:
        clasificacion = "SIMETRIA DE MEDIA ONDA"
    else:
        clasificacion = "NINGUNA SIMETRIA (SENAL ASIMETRICA)"

    metricas = {
        "par": err_par,
        "impar": err_impar,
        "media_onda": err_mw,
        "es_par": es_par,
        "es_impar": es_impar,
        "es_media_onda": es_media_onda,
    }

    return clasificacion, metricas, T_estimado


def ejecutar_reconocimiento_por_imagen():
    """
    Flujo interactivo para adjuntar cualquier imagen de señal (sin ingresar
