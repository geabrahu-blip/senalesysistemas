    print(f"Eje t = 0        : {'Estimado (centro)' if eje_x_est else 'Detectado automaticamente'}")
    print(f"Eje y = 0        : {'Estimado (centro)' if eje_y_est else 'Detectado automaticamente'}")
    print("----------------------------------------------------------")
    print(f"  Similitud Par        : {sim_par:6.2f}%  {'[CUMPLE]' if metricas['es_par'] else ''}")
    print(f"  Similitud Impar      : {sim_impar:6.2f}%  {'[CUMPLE]' if metricas['es_impar'] else ''}")
    print(f"  Similitud Media Onda : {sim_mw:6.2f}%  {'[CUMPLE]' if metricas['es_media_onda'] else ''}")
    print("----------------------------------------------------------")
    print(f">>> RESULTADO FINAL: {clasificacion} <<<")
    print("==========================================================\n")

    fig_img, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5.5))

    ax1.imshow(cv2.cvtColor(roi, cv2.COLOR_BGR2RGB))
    ax1.axhline(y0_final, color="red", linestyle="--", linewidth=1.3, label="Eje y = 0 usado")
    if x0_orig is not None:
        ax1.axvline(x0_orig, color="lime", linestyle="--", linewidth=1.3, label="Eje t = 0 usado")
    else:
        ax1.axvline(0.5 * (x_ini + x_fin), color="lime", linestyle=":", linewidth=1.3, label="Centro t = 0 estimado")
    ax1.set_title("Imagen procesada y ejes detectados", fontsize=12, fontweight="bold")
    ax1.legend(loc="best", fontsize=9)
    ax1.axis("off")

    eje_t = np.arange(len(y_norm)) - idx_x0
    ax2.plot(eje_t, y_norm, color="tab:blue", linewidth=2.4, label="Señal extraída (limpia)")
    ax2.axhline(0, color="black", linewidth=0.9, alpha=0.7)
