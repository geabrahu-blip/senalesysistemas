print(f"Son validas para n = 1, 2, ..., N1 = {N1}.")

print("\nFormula general de a_n:")
sp.pprint(
    sp.Eq(sp.Symbol("a_n"), a_n_generico),
    use_unicode=True
)

print("\nFormula general de b_n:")
sp.pprint(
    sp.Eq(sp.Symbol("b_n"), b_n_generico),
